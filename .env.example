NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server) — Service account for Stripe webhook credit grants
# Project settings → Service accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# OpenRouter (AI grading) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Vision-capable model, e.g. google/gemini-2.5-flash or openai/gpt-4o
OPENROUTER_MODEL=google/gemini-2.5-flash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PriceCharting / SportsCardsPro — live raw + PSA comps for ROI
# Get a token from your subscription: https://www.sportscardspro.com (API/Download)
# or https://www.pricecharting.com — Legendary/paid plan required for price fields
PRICECHARTING_API_TOKEN=
# Optional override if you use the games domain instead of sportscardspro
# PRICECHARTING_API_BASE=https://www.pricecharting.com

# Stripe Checkout — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Local: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — map to Stripe Product catalog:
#   Lot Plan ($4.99)        → STRIPE_PRICE_LOT_PRICE
#   Pro Single ($7.99)      → STRIPE_PRICE_PROFESSIONAL
#   Starter Plan ($29.99)   → STRIPE_PRICE_STARTER
#   Collector Plan ($49.99) → STRIPE_PRICE_COLLECTOR
#   Dealer Plan ($199.99)   → STRIPE_PRICE_DEALER
STRIPE_PRICE_LOT_PRICE=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_COLLECTOR=
STRIPE_PRICE_DEALER=
